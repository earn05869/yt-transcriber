{
  "_comment": "Post-process Whisper ASR + translate. Extend per series. jp_* fields are optional gates.",
  "whisper_initial_prompt": "Anime Hyouka dialogue. Kamiyama High School cultural festival Kanya-sai. Classic Literature Club Koten-bu. Characters: Oreki Houtarou, Chitanda Eru, Ibara Mayaka, Fukube Satoshi. Kaburaya Junior High. Terms: bunshuu anthology, koten classical literature.",
  "strip_en_suffix_regex": [
    "(?i)\\s*thank you for watching\\.?!?\\s*$",
    "(?i)\\s*thank you for your viewing\\.?!?\\s*$",
    "(?i)\\s*please subscribe[^.]*\\.?\\s*$",
    "(?i)\\s*like and subscribe[^.]*\\.?\\s*$",
    "(?i)\\s*hit the bell[^.]*\\.?\\s*$"
  ],
  "omit_segment_if_en_fullmatch_regex": [
    "(?i)^\\s*thank you for watching\\.?!?\\s*$",
    "(?i)^\\s*thank you for your viewing\\.?!?\\s*$",
    "(?i)^\\s*please subscribe[^.]*\\.?\\s*$"
  ],
  "omit_segment_if_jp_fullmatch_regex": [
    "^(ご視聴ありがとう|チャンネル登録|高評価).*$"
  ],
  "en_global_replacements": [
    {"pattern": "(?i)\\bOrekki\\b", "replace": "Oreki"},
    {"pattern": "(?i)\\bUrek\\b", "replace": "Oreki"},
    {"pattern": "(?i)\\bMayuka\\b", "replace": "Mayaka"},
    {"pattern": "(?i)\\bChiton\\b", "replace": "Chitanda"},
    {"pattern": "(?i)store department", "replace": "Classic Literature Club"},
    {"pattern": "(?i)\\bthe shop\\b", "replace": "the Classic Literature Club"},
    {"pattern": "(?i)Tatenosai", "replace": "Kanya-sai"},
    {"pattern": "(?i)Kanyasai", "replace": "Kanya-sai"},
    {"pattern": "(?i)Kaburaya-chu", "replace": "Kaburaya Junior High"},
    {"pattern": "(?i)Kaburaya chu", "replace": "Kaburaya Junior High"},
    {"pattern": "(?i)\\(Translating\\.\\.\\.\\)", "replace": ""}
  ],
  "jp_gated_en_fixes": [
    {
      "jp_contains_any": ["古典部"],
      "when_en_contains_any": ["store", "shop", "department"],
      "replace_first_match": {
        "pattern": "(?i)(store department|the shop|shop department|club shop)",
        "replace": "Classic Literature Club (Koten-bu)"
      }
    },
    {
      "jp_contains_any": ["文集"],
      "when_en_contains_any": ["analysis"],
      "replace_first_match": {
        "pattern": "(?i)analysis",
        "replace": "club anthology (bunshuu)"
      }
    },
    {
      "jp_contains_any": ["二毛作", "２毛作"],
      "when_en_contains_any": ["double-edged", "two-edged", "double edged"],
      "replace_entire_en": "That's two crops a year — double cropping. (Chitanda's pun on nimonsaku.)"
    },
    {
      "jp_contains_any": ["不毛"],
      "when_en_contains_any": ["right?", "isn't it", "is it"],
      "replace_first_match": {
        "pattern": "(?i)^(right\\?|isn't it\\??|is it\\??)\\s*$",
        "replace": "So it's futile, then? / Barren, is it?"
      }
    },
    {
      "jp_contains_any": ["御本", "ご本"],
      "when_en_contains_any": ["5 books", "five books"],
      "replace_entire_en": "*ahem* (Mayaka clearing her throat — homophone with gohon)"
    },
    {
      "jp_contains_any": ["気がすすまん", "気が進まん", "気が進みませ"],
      "when_en_contains_any": ["can't breathe", "breathe"],
      "replace_first_match": {
        "pattern": "(?i).*(can't breathe|cannot breathe|I can't breathe).*",
        "replace": "I'm not really up for it. / I don't feel like going."
      }
    },
    {
      "jp_contains_any": ["浅漬け", "重ねれ"],
      "when_en_contains_any": ["morning drink", "pickles"],
      "replace_first_match": {
        "pattern": "(?i).*(morning drink|will be used).*",
        "replace": "Stack enough of them and you could use them as a pickle press / for asazuke."
      }
    }
  ]
}
